# Render와 로컬 production 빌드에 필요한 공개 클라이언트 설정입니다.
# 실제 값은 .env 또는 Render Environment에 입력하고 이 파일에는 작성하지 마세요.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Open-Meteo는 API 키가 필요 없습니다. 다른 호환 엔드포인트를 사용할 때만 변경하세요.
WEATHER_API_URL=https://api.open-meteo.com/v1/forecast

# Render 빌드 환경을 로컬 검증 버전과 맞춥니다.
NODE_VERSION=24.19.0
